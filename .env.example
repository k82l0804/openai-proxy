# Copy this file to .env and fill in your keys:  cp .env.example .env
#
# .env is gitignored — never commit your real keys.

# The key clients send to this proxy (Authorization: Bearer ...). Make up a long random one, e.g.:
#   echo "sk-$(openssl rand -hex 24)"
# Clients that use the proxy need the same value (ai-vendor-agent-cli-containers reads it from its own .env).
LITELLM_MASTER_KEY=

# Upstream provider keys. Leave a key empty if you don't have it: only the models that use it will fail.
# Most models (see litellm_config.yaml) go through OpenRouter: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
# gemini-3.6-flash: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# grok-4.7 (xAI direct; or-grok-4.7 is the same model via OpenRouter): https://console.x.ai
GROK_API_KEY=
